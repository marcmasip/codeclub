<?xml version="1.0"?>
<JWM>

   <RootMenu height="32" onroot="123" label="codeclub">

	
	
    <Program label="Term" icon="xterm.svg" >  exec -a MyTermmm /usr/bin/wezterm </Program>
    
    <Program label="Files" icon="dde-file-manager.svg" > exec spacefm</Program>
    
    <Program label="HTTP" icon="baloo.svg" > exec ~/installed/firefox/firefox</Program>
    
	  <Menu label="Edit" icon="builder.svg">
		  <Program label="Text" icon="com.github.johnfactotum.Foliate.svg">exec geany</Program>
		  <Program label="Code" icon="apps/apache-netbeans.svg">exec ~/installed/code.sh</Program>
		  <Program label="Data" icon="datamodeler.svg">exec PATH=$PATH:/opt/jdk/bin ~/installed/dbeaver/dbeaver</Program>
		  <Program label="Image" icon="kdots.svg" >exec ~/inkscape</Program>
		  <Program label="3D / Video" icon="blender.svg">exec ~/installed/blender/blender </Program>
		  <Program label="3D Ptr" icon="cura-icon.svg">exec ~/installed/Cura </Program>
	  </Menu>
	  
	  <Menu label="Serve" icon="com.github.alecaddd.sequeler.svg">
		<Program label="Docker" icon="docker-desktop">exec /usr/bin/wezterm --config-file=/home/marc/.wezterm-docker.lua start -- sudo -i /home/marc/installed/docker.sh</Program>
	  
	  </Menu>
	  
	  <Menu label="Game" icon="antimicro.svg">
		<Program label="OpenTTD" icon="openttd.svg">exec ~/installed/openttd/openttd</Program>
		<Program label="Minecraft (To fix)" icon="com.mojang.Minecraft.svg"></Program>
		<Program label="Steam (ToDo 32bit)" icon="com.valvesoftware.Steam.svg"></Program>
	  </Menu>
   

	  <Menu label="Adjust" icon="litetweaks.svg">
		  <Program label="Root" icon="bash.svg">  exec /usr/bin/wezterm --config-file=/home/marc/.wezterm-root.lua start -- sudo -i  </Program>
		   <Program label="Text" icon="com.github.johnfactotum.QuickLookup.svg">  exec sudo geany  </Program>
		   <Program label="Files" icon="fma-config-tool.svg">  exec sudo spacemanfm  </Program>
		    <Separator/>
		  <Program label="Audio" icon="gnome-settings-sound.svg">exec /usr/bin/wezterm start -- alsamixer</Program>
		  <Program label="Menu" icon="com.github.johnfactotum.QuickLookup.svg">exec geany ~/.jwmrc</Program>
	 
	   
		<Restart label="Restart WM" icon="ar.xjuan.Cambalache.svg"/>
				  <Program label="Info" icon="choqok.svg">  exec /usr/bin/wezterm --config-file=/home/marc/.wezterm.info.lua start -- bash -c "cd /mnt/club/guides/ ; sudo ./info.sh && sleep 20"  </Program>


  <Separator/>
	   
	   <Program label="Suspend" icon="braindump.svg">exec sudo shutdown pause</Program>
		<Program label="Exit" icon="backdoor-factory.svg"> exec kill $XPID</Program>
		
	  </Menu>

 </RootMenu>
 
   <MenuStyle>
	<Outline>#c2c2c2
	</Outline>
	<Opacity>0.5</Opacity>
  </MenuStyle>

<Tray layout="vertical" width="640" layer="below" halign="left" valign="center" >
 <TaskList/> 
</Tray>


<Tray halign="left" valign="bottom" height="48">
	<Pager/>
	
</Tray>
   

  <Tray halign="right" valign="bottom" height="48">
	  <Dock/>	  
	   <Swallow width="32" height="32" name="xclock">xclock</Swallow>
      <Clock format="%a %d %b %k:%M" width="300"><Button mask="123">exec:</Button></Clock>
   </Tray>
   


   <WindowStyle  decorations="motif">
         <Foreground>#999</Foreground>
         <Background>#d2d2d2:#d2d2d2</Background>
         <Outline>#d2d2d2</Outline>
	<Corner>1</Corner>

      <Font antialias="true">Monaspace Neon-10</Font>
      <Width>2</Width>
      <Height>24</Height>

      <Active>
         <Foreground>#FFEC9E</Foreground>
         <Background>#ED9455</Background>
         <Outline>#ED9455</Outline>
		<Font antialias="true">Monaspace Neon-10:bold</Font>
      </Active>

      

   </WindowStyle>

   <ClockStyle>
		 <Foreground>#ED9455</Foreground>
      <Background>#0C0C0C</Background>
      <Font antialias="true">Monaspace Krypton-14:bold</Font>
   </ClockStyle>

   <!-- Additional TrayStyle attribute: insert -->
   <TrayStyle  >
      <Font antialias="false">Monaspace Neon-10</Font>
      <Background>#0C0C0C</Background>
      <Foreground>#c5c5c5</Foreground>
      <Active>
		   <Background>#ED9455</Background>
      <Foreground>#FFEC9E</Foreground>
	</Active>
   </TrayStyle>
   
    <TaskListStyle list="desktop" >
     <Font antialias="true">Monaspace Neon-10</Font>
     <Active>
            <Foreground>#000</Foreground>
      </Active>
     
      <Foreground>#999</Foreground>
      <Background>#000</Background>
      
    </TaskListStyle>

   <PagerStyle>
      <Outline>black</Outline>
      <Foreground>#c5c5c5</Foreground>
      <Background>#0C0C0C</Background>
         <Active>
            <Background>#2e3a67</Background
            <Foreground>#70849d</Foreground>
         </Active>
    </PagerStyle>

   <MenuStyle>
	  
      <Font antialias="true">Monaspace Neon-10</Font>
      <Foreground>#333</Foreground>
       <Outline>#c2c2c2</Outline>
      <Background>#fafafa</Background>
         <Active>
            <Background>#ED9455</Background>
            <Foreground>white</Foreground>
         </Active>
   </MenuStyle>

   <PopupStyle enabled="false">
      <Font antialias="false">Monaspace Neon-13</Font>
      <Outline>black</Outline>
      <Foreground>white</Foreground>
      <Background>#000080</Background>
   </PopupStyle>
   
   
   <IconPath>
/usr/share/icons/ePapirus/24x24/apps
   </IconPath>
   <IconPath>
      /usr/share/icons/Fluent-green/scalable
   </IconPath>

   <IconPath>
      /usr/share/pixmaps
   </IconPath>
   <IconPath>
       /club/graphics
   </IconPath>
   
   
   <Key   keycode="191">exec:/home/marc/installed/firefox/firefox </Key>
   <Key   keycode="192">exec:/usr/bin/wezterm </Key>
   <Key   keycode="193">exec:spacefm </Key>
  <Key keycode="194">close</Key>

   <!-- Virtual Desktops -->
   <!-- Desktop tags can be contained within Desktops for desktop names. -->
   <Desktops width="6">

      <!-- Default background. Note that a Background tag can be
           contained within a Desktop tag to give a specific background
           for that desktop.
           
           Valid types: solid gradient image tile command
           <Background type="solid">#4f5f82</Background>
           Note: Tiny Core uses a generic setbackground program
       -->
       <Desktop name="Home">

       </Desktop>
       <Desktop name="Code"></Desktop>
       <Desktop name="Graphics"></Desktop>
       <Desktop name="Info"></Desktop>
       <Desktop name="Services"></Desktop>
       <Desktop name="System">
       
       </Desktop>

   </Desktops>
    <SnapMode distance="10">border</SnapMode>
   
   <Group >
		<Class>org.wezfurlong.wezterm</Class>
        <Option>icon:bash.svg</Option>
       
   </Group>
   
   <Group >
    <Name>geany</Name>
        <Option>icon:com.github.johnfactotum.Foliate.svg</Option>
   </Group>
   
    <Group >
		<Name>spacefm</Name>
        <Option>icon:dde-file-manager.svg</Option>
   </Group>
   
   <Group >
		<Name>Firefox</Name>
        <Option>icon:baloo.svg</Option>
   </Group>
   
   <!-- Double click speed (in milliseconds) -->
   <DoubleClickSpeed>400</DoubleClickSpeed>

   <!-- Double click delta (in pixels) -->
   <DoubleClickDelta>2</DoubleClickDelta>

   <!-- The focus model (sloppy or click) -->
   <FocusModel>click</FocusModel>

   <!-- The snap mode (none, screen, or border) -->
   <SnapMode distance="10">border</SnapMode>

   <!-- The move mode (outline or opaque) -->
   <MoveMode>outline</MoveMode>

   <!-- The resize mode (outline or opaque) -->
   <ResizeMode>outline</ResizeMode>

</JWM>
